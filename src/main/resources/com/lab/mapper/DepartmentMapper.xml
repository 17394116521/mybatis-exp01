<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.mapper.DepartmentMapper">
    <resultMap id="deptEmpMap" type="Department">
        <id column="dept_id" property="deptId"/>
        <result column="dept_name" property="deptName"/>
        <result column="location" property="location"/>
        <!--一对多集合，ofType指定集合里面元素是Emp-->
        <collection property="empList" ofType="Emp">
            <id column="emp_id" property="empId"/>
            <result column="emp_name" property="empName"/>
            <result column="gender" property="gender"/>
            <result column="dept" property="dept"/>
            <result column="post" property="post"/>
            <result column="salary" property="salary"/>
            <result column="hire_date" property="hireDate"/>
            <result column="status" property="status"/>
        </collection>
    </resultMap>

    <select id="findDeptWithEmpById" resultMap="deptEmpMap">
        SELECT d.dept_id, d.dept_name, d.location,
               e.emp_id, e.emp_name, e.gender, e.dept, e.post, e.salary, e.hire_date, e.status,
               e.dept_id AS emp_dept_id
        FROM department d
                 LEFT JOIN emp e ON d.dept_id = e.dept_id
        WHERE d.dept_id = #{deptId}
    </select>
</mapper>
